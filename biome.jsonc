{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "assist": {
    "actions": {
      "source": {
        "noDuplicateClasses": "on",
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":BUN:", ":NODE:"],
              ":BLANK_LINE:",
              ":URL:",
              ":BLANK_LINE:",
              [":PACKAGE_WITH_PROTOCOL:", ":PACKAGE:"],
              ":BLANK_LINE:",
              ["ALIAS", "PATH"]
            ],
            "identifierOrder": "lexicographic"
          }
        },
        "useGraphqlSortedArguments": "on",
        "useGraphqlSortedDefinitions": "on",
        "useGraphqlSortedVariables": "on",
        "useSortedAttributes": "on",
        "useSortedEnumMembers": "on",
        "useSortedInterfaceMembers": "on",
        "useSortedKeys": "on",
        "useSortedPackageJson": "on",
        "useSortedProperties": "on",
        "useSortedSelectionSet": "on",
        "useSortedTypeFields": "on"
      }
    }
  },
  "css": {
    "formatter": {
      "enabled": true,
      "quoteStyle": "single"
    },
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["src/**/*", "__{tests,mocks,snapshots}__/**/*"]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true,
      "indentScriptAndStyle": true,
      "selfCloseVoidElements": "always"
    },
    "parser": {
      "interpolation": true
    }
  },
  "javascript": {
    "formatter": {
      "bracketSameLine": true,
      "jsxQuoteStyle": "single",
      "quoteStyle": "single",
      "trailingCommas": "es5"
    }
  },
  "linter": {
    "domains": {
      "astro": "all",
      "drizzle": "all",
      // "next": "all", • Conflicts w/ React
      "playwright": "all",
      "project": "all",
      // "qwik": "all", • Conflicts w/ React
      "react": "all",
      "reactNative": "all",
      // "solid": "all", • Conflicts w/ React
      "svelte": "all",
      "tailwind": "all",
      "tanstackQuery": "all",
      "test": "all",
      "turborepo": "all",
      "types": "all",
      "vue": "all"
    },
    "rules": {
      // Missing • padding-line-between-statements
      "a11y": {
        "noNoninteractiveElementInteractions": "error"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "info",
        "noExcessiveLinesPerFunction": {
          "level": "info",
          "options": {
            "maxLines": 100,
            "skipBlankLines": true
          }
        },
        "noRedundantDefaultExport": "warn",
        "noUnnecessaryTemplateExpression": "info",
        "noUselessReturn": "info",
        "useArraySome": "info",
        "useRegexpTest": "warn",
        "useSimplifiedLogicExpression": "info",
        "useWhile": "warn"
      },
      "correctness": {
        "noNestedComponentDefinitions": "error", // React
        "noUnresolvedImports": "off",
        "noUnusedInstantiation": "info",
        "useSingleJsDocAsterisk": "info",
        "useUniqueElementIds": "off" // React
      },
      "nursery": {
        "noArraySortForMinMax": "warn",
        "noAstroConflictingSetDirectives": "error", // Astro
        "noAstroSetHtmlDirective": "error", // Astro
        "noBaseToString": "info", // Types
        "noBooleanSortComparator": "error",
        "noEagerArrayMethodsInLoops": "warn",
        "noExtendNative": "error",
        "noFloatingPromises": "info", // Types
        "noImpliedEval": "error",
        "noMeaninglessVoidOperator": "info", // Types
        "noMisleadingReturnType": "info", // Types
        "noMisusedPromises": "info", // Types
        "noNewRequire": "error",
        "noObsoleteAttributes": "info", // HTML
        "noPathConcat": "warn",
        "noPlaywrightNthMethods": "info", // Playwright
        "noReactObjectTypeAsDefaultProp": "error", // React
        // "noReactNativeRawText": "error", // React Native • Conflicts w/ React
        "noRestrictedDependencies": "info",
        "noReturnInFinally": "error",
        "noSelfNestedLayer": "warn", // CSS
        "noSvelteAtHtmlTags": "error", // Svelte
        "noSvelteExportLet": "info", // Svelte
        "noSvelteInternal": "info", // Svelte
        "noSvelteLegacyConst": "info", // Svelte
        "noSvelteUnnecessaryStateWrap": "info", // Svelte
        "noTailwindLegacyUtilities": "warn", // Tailwind • CSS
        "noTanstackQueryRestDestructuring": "warn", // TanStack
        "noUnreadableForOfExpression": "info",
        "noUnsafePlusOperands": "info", // Types
        "noUnsafeReturn": "error", // Types
        "noUselessSplice": "warn",
        "noUselessTypeConversion": "info", // Types
        "noVueUnusedEmitDeclarations": "warn", // Vue
        "noVueVTextVHtmlOnComponent": "error", // Vue
        "noVueWatchAfterAwait": "error", // Vue
        "noXorAsExponentiation": "warn",
        "noZeroLengthUnit": "info", // CSS
        "useAstroClientOnlyDirectiveValue": "warn", // Astro
        "useBetterDomTraversing": "info", // HTML
        "useDisposables": "error", // Types
        "useExhaustiveSwitchCases": "warn", // Types
        "useExplicitReturnType": "error",
        "useIncludes": "info", // Types
        "useLogicalProperties": "info", // CSS
        "useNamedLayer": "warn", // CSS
        "useNullishCoalescing": "warn", // Types
        "useReactCompiler": "warn", // React
        "useReactFunctionComponentDefinition": {
          "level": "info", // React
          "options": {
            "namedComponents": "arrowFunction"
          }
        },
        "useRegexpExec": "info", // Types
        "useStringStartsEndsWith": "info", // Types
        "useSvelteKitRuneImports": "warn", // Svelte
        "useSvelteRequireEachKey": "error", // Svelte
        "useTailwindShorthandClasses": "info", // Tailwind • CSS
        // "useScopedStyles": "info", // Vue • Conflicts w/ React
        "useTailwindSortedClasses": "warn", // Tailwind • CSS
        "useValidTestTitle": "warn" // Test
        // "noVueRefAsOperand": "error" // Vue • Conflicts w/ React
      },
      "performance": {
        "noAwaitInLoops": "info",
        "noBarrelFile": "warn",
        "noDelete": "warn",
        "noJsxPropsBind": "off", // React
        "noNamespaceImport": "warn",
        "noReExportAll": "warn",
        "useTopLevelRegex": "warn"
      },
      "preset": "recommended",
      "security": {
        "noSecrets": {
          "level": "error",
          "options": {
            "entropyThreshold": 55
          }
        },
        "useIframeSandbox": "warn"
      },
      "style": {
        "noCommonJs": "warn",
        "noDefaultExport": "warn",
        "noExcessiveClassesPerFile": {
          "level": "info",
          "options": {
            "maxClasses": 2
          }
        },
        "noExcessiveLinesPerFile": {
          "level": "info",
          "options": {
            "maxLines": 350,
            "skipBlankLines": true
          }
        },
        "noMagicNumbers": "warn",
        "noNegationElse": "info",
        "noReactNativeLiteralColors": "info", // React Native
        // https://github.com/biomejs/biome/issues/5936#issuecomment-3876398540
        "noRestrictedImports": {
          "level": "warn",
          "options": {
            "patterns": [
              {
                "group": ["../*"],
                "message": "Relative imports nested more than one level are not allowed."
              }
            ]
          }
        },
        "noShoutyConstants": "info",
        "noSubstr": "info",
        "noTopLevelLiterals": "error", // JSON
        "noUnusedTemplateLiteral": "warn",
        "noUselessElse": "info",
        "noYodaExpression": "info",
        "useAsConstAssertion": "info",
        "useAtIndex": "info",
        "useCollapsedElseIf": "info",
        "useCollapsedIf": "info",
        "useComponentExportOnlyModules": {
          "level": "error", // React
          "options": {
            "allowConstantExport": true
          }
        },
        "useConsistentArrayType": "info",
        "useConsistentArrowReturn": "info",
        "useConsistentMemberAccessibility": {
          "level": "error",
          "options": {
            "accessibility": "explicit"
          }
        },
        "useConsistentTestIt": "warn", // Test
        "useDefaultParameterLast": "warn",
        "useDefaultSwitchClause": "warn",
        "useErrorCause": "info",
        "useExportsLast": "info",
        "useForOf": "info",
        "useFragmentSyntax": "info",
        "useGlobalThis": "warn",
        "useGroupedAccessorPairs": "info",
        "useImportsFirst": "warn",
        "useNamedCaptureGroup": "info",
        "useReadonlyClassProperties": {
          "level": "info",
          "options": {
            "checkAllProperties": true
          }
        },
        "useReduceTypeParameter": "info",
        "useSelfClosingElements": "info",
        "useShorthandAssign": "info",
        "useSpreadOverApply": "info",
        "useTemplate": "off",
        "useTestHooksInOrder": "warn", // Test
        "useTestHooksOnTop": "warn", // Test
        "useThisInClassMethods": "warn",
        "useThrowNewError": "warn",
        "useThrowOnlyError": "warn",
        "useTrimStartEnd": "info",
        "useUnifiedTypeSignatures": "info",
        "useVueConsistentDefinePropsDeclaration": "info" // Vue
      },
      "suspicious": {
        "noConditionalExpect": "info", // Test
        "noDuplicateDependencies": "error",
        "noDuplicateSelectors": "error", // CSS
        "noEmptyBlock": "warn",
        "noEmptyBlockStatements": "warn",
        "noEmptyObjectKeys": "error", // JSON
        "noEmptySource": "warn",
        "noEvolvingTypes": "error",
        "noJsxLeakedDollar": "warn", // React
        "noMisplacedAssertion": "warn",
        "noUnassignedVariables": "error",
        "noUnknownAttribute": "off", // React
        "noUntrustedLicenses": "warn", // Project
        "noUnusedExpressions": "warn",
        "noVar": "error",
        "useAwait": "error",
        "useBaseline": {
          "level": "info", // CSS
          "options": {
            "available": "newly"
          }
        },
        "useExpect": "info", // Test
        "useGuardForIn": "warn",
        "useNumberToFixedDigitsArgument": "warn"
      }
    }
  },
  "markdown": {
    "analyzeEmbeds": true,
    "formatter": {
      "lineWidth": 120
    },
    "parser": {
      "cjkFriendlyEmphasis": true,
      "frontmatter": true
    }
  },
  "vcs": {
    "clientKind": "git",
    "defaultBranch": "main",
    "enabled": true,
    "useIgnoreFile": true
  },
  "yaml": {
    "formatter": { "quoteStyle": "single" }
  }
}
