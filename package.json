{
  "name": "eldarlrd",
  "private": true,
  "version": "1.10.0",
  "keywords": [
    "docs",
    "blog",
    "tech"
  ],
  "description": "eldarlrd's docs & blog",
  "repository": "github:eldarlrd/eldarlrd",
  "homepage": "https://eldarlrd.is-a.dev/eldarlrd",
  "author": "Eldar Paşazadə <eldarlrd@pm.me> (https://eldarlrd.is-a.dev)",
  "scripts": {
    "dev": "docusaurus start",
    "bundle": "docusaurus build && cp 404.html build",
    "serve": "bun bundle && docusaurus serve",
    "ship": "bun bundle && gh-pages -b prod -m 'build(prod): shipment' -d build",
    "fix": "biome check --fix --unsafe --no-errors-on-unmatched --reporter=concise",
    "orphans": "knip-bun --cache --no-exit-code"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "knip": {
    "ignoreFiles": [
      "src/theme.sass"
    ],
    "ignoreDependencies": [
      "@docusaurus/tsconfig",
      "clsx"
    ]
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/plugin-content-docs": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "docusaurus-plugin-sass": "^0.2.7",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.106.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "gh-pages": "^6.3.0",
    "knip": "^6.43.0",
    "lefthook": "^2.2.2",
    "typescript": "^7.0.2"
  },
  "babel": {
    "presets": [
      "@docusaurus/core/lib/babel/preset"
    ]
  }
}
