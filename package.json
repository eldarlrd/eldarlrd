{
  "name": "eldarlrd",
  "private": true,
  "version": "1.0.9",
  "keywords": [
    "docs",
    "blog",
    "tech"
  ],
  "description": "eldarlrd's docs & blog",
  "repository": "github:eldarlrd/eldarlrd",
  "homepage": "https://eldarlrd.is-a.dev/eldarlrd",
  "author": "Eldar Pashazade <eldarlrd@pm.me> (https://eldarlrd.is-a.dev)",
  "scripts": {
    "dev": "docusaurus start",
    "bundle": "docusaurus build && cp 404.html build",
    "serve": "docusaurus serve",
    "deployer": "bun bundle && gh-pages -b prod -m 'build(prod): deployment' -d build",
    "fix": "biome check --fix --unsafe --no-errors-on-unmatched --reporter=concise",
    "orphans": "knip --cache --no-exit-code"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.1",
    "@docusaurus/plugin-content-docs": "^3.10.1",
    "@docusaurus/preset-classic": "^3.10.1",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "docusaurus-plugin-sass": "^0.2.6",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sass": "^1.101.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@docusaurus/module-type-aliases": "^3.10.1",
    "@docusaurus/tsconfig": "^3.10.1",
    "@docusaurus/types": "^3.10.1",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "gh-pages": "^6.3.0",
    "knip": "^6.25.0",
    "lefthook": "^2.1.9",
    "typescript": "^6.0.3"
  },
  "babel": {
    "presets": [
      "@docusaurus/core/lib/babel/preset"
    ]
  }
}
